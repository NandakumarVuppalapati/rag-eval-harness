# Copy this file to .env and fill in real values. Never commit .env itself.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
GITHUB_TOKEN=

# Optional overrides for docker/docker-compose.yml -- all have working
# defaults (see that file), only needed to change the local Postgres/
# Grafana/Airflow admin credentials from their defaults.
# POSTGRES_USER=rag_eval
# POSTGRES_PASSWORD=rag_eval
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# AIRFLOW_ADMIN_USER=admin
# AIRFLOW_ADMIN_PASSWORD=admin

# Optional: where the observability layer persists eval runs. Defaults to
# a local SQLite file (see scripts/load_eval_results.py) when unset; the
# Docker Compose stack sets this automatically to point at its Postgres.
# DATABASE_URL=
